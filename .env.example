# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Business identity - see lib/brand/identity.ts (the one file to edit for
# your business's name/company/etc). These two are env-driven because
# they're shown on public, unauthenticated pages (booking confirmations).
NEXT_PUBLIC_OWNER_PHONE_E164=+10000000000
NEXT_PUBLIC_OWNER_PHONE_DISPLAY=000-000-0000

# Your Supabase user ID (Authentication -> Users -> copy the UID column) -
# this app is single-owner/single-tenant: every cron and webhook writes
# against this one account.
CRM_OWNER_USER_ID=
# Project Settings -> API -> service_role key. SERVER-ONLY SECRET - never
# expose this to the browser or prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail sync, sending, and sequences - see README's Gmail section
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client - your
# deployed app's own domain.
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/auth/gmail/callback
# Used to build tracking-pixel/click-redirect/unsubscribe links in sequence
# emails, and as the fallback origin in a few places - your app's own domain.
APP_BASE_URL=https://your-domain.example.com
# Any random string you choose - authenticates Vercel Cron's calls to
# /api/cron/*. Vercel sets this automatically as a project env var when you
# add a cron job, but confirm it's actually set after deploying.
CRON_SECRET=

# Quo (formerly OpenPhone) call/text sync - see README's Quo section
# Quo dashboard -> Settings -> API
QUO_API_KEY=
# Returned when you create the webhook via the Quo API - see README
QUO_WEBHOOK_SIGNING_KEY=
# Set to "true" once QUO_WEBHOOK_SIGNING_KEY is confirmed working, to start
# rejecting unsigned/invalid webhook requests. Leave unset while testing.
# CRM_QUO_ENFORCE_SIGNATURE=true
# Optional - only needed if you run more than one number on the Quo
# account and want calls/texts from the other number(s) left out of the
# CRM entirely. Comma-separated list of the number(s) that SHOULD be
# pulled in - any format. Leave unset to pull in every number on the
# account, same as before this existed.
QUO_INCLUDED_PHONE_NUMBERS=
# REQUIRED if the Quo account has more than one phone number on it - the
# exact number outbound texts should send from (any format). Without this,
# the CRM has no way to know which of your numbers is the business line,
# and texts can go out from the wrong one. Leave unset only if there's
# just one number on the account.
QUO_SEND_PHONE_NUMBER=

# Calendly booking sync - see README's Calendly section
# Personal Access Token (Calendly -> Integrations -> API & Webhooks), used
# once to register the webhook subscription
CALENDLY_API_TOKEN=
# Returned when you create the webhook subscription via the Calendly API
CALENDLY_WEBHOOK_SIGNING_KEY=
# Same idea as CRM_QUO_ENFORCE_SIGNATURE - leave unset while testing
# CRM_CALENDLY_ENFORCE_SIGNATURE=true

# Granola meeting/note transcripts (video calls, in-person notes, phone
# memos) - see README's Granola section. Granola is pointed straight at
# this webhook from its own settings, no Zapier/Make relay needed. Any
# random string you choose - baked into the webhook URL as ?secret=...
# since there's no signature to verify instead.
GRANOLA_WEBHOOK_SECRET=
# REQUIRED for notes to actually sync - Granola's webhook only sends a thin
# "this note changed" ping, never the transcript itself, so this key is
# used to fetch the real content by note id. A Workspace API key (not a
# Personal one), Granola desktop app -> Settings -> Connectors -> API keys
# (or your workspace admin settings for a Workspace key) -> the scope needs
# to cover whichever space(s) your notes live in.
GRANOLA_API_KEY=

# AI insights - see README's AI insights section
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Rate-move alerts (Insights) - optional. A free API key from
# fred.stlouisfed.org lets the daily cron pull a real mortgage rate
# automatically. Leave unset and just type the day's rate into Settings
# whenever you want a rate-move check - the alert logic works identically
# either way, this only saves you typing it in.
FRED_API_KEY=

# Instagram DMs (Messages inbox) - see README's Instagram section. All
# three required together for this to do anything; leave unset and this
# integration just stays dormant, same as Calendly before it's set up.
# From your Meta Developer App -> App Settings -> Basic.
META_APP_SECRET=
# Any random string you choose - typed into the same field in the Meta
# App Dashboard's webhook subscription setup, confirms the GET handshake.
META_VERIFY_TOKEN=
# From the Facebook Page connected to your Instagram professional account
# -> generate a (long-lived) Page Access Token with the
# instagram_manage_messages permission.
META_PAGE_ACCESS_TOKEN=

# Blinq digital business card capture - see README's Blinq section.
# Reached via Zapier (Blinq Business's "Contact Created" trigger -> a
# Webhooks by Zapier POST action), so this is a secret you choose
# yourself, baked into the webhook URL as ?secret=..., same idea as
# GRANOLA_WEBHOOK_SECRET since neither Blinq nor Zapier's generic webhook
# action signs requests.
BLINQ_WEBHOOK_SECRET=

# Push notifications (new-lead alerts) - generate once with
# `npx web-push generate-vapid-keys` and never regenerate afterward, or
# every device that already enabled notifications will need to re-enable.
# The public key is exposed to the browser on purpose (that's how Web Push
# works); the private key is server-only, never expose it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: address - required by the Web Push spec so a push service can
# contact you if it needs to (e.g. Chrome flags your key as sending too much).
VAPID_SUBJECT=mailto:you@example.com

# Eventbrite registrations + check-ins (app/api/webhooks/eventbrite).
# One private token per connected Eventbrite account, comma-separated:
# Eventbrite -> Account Settings -> Developer Links -> API Keys -> Private token.
EVENTBRITE_PRIVATE_TOKENS=
# Any random string; append ?secret=<this> to the webhook URL in each account.
EVENTBRITE_WEBHOOK_SECRET=
